<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/EstiloTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bem-vindo de volta" />

            <TextView
                style="@style/EstiloSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Entre com seu usuário e senha" />

            <EditText
                android:id="@+id/etUsuario"
                style="@style/EstiloCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Usuário"
                android:inputType="text" />

            <EditText
                android:id="@+id/etSenha"
                style="@style/EstiloCampo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Senha"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/tvMensagem"
                style="@style/EstiloMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=" " />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEntrar"
                style="@style/EstiloBotao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Entrar" />

            <TextView
                android:id="@+id/tvCadastro"
                style="@style/EstiloLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Criar cadastro" />

            <TextView
                android:id="@+id/tvRecuperar"
                style="@style/EstiloLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esqueci minha senha" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
