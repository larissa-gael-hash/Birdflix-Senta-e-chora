<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitulo"
            style="@style/EstiloTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivFoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_foto"
                android:clipToOutline="true"
                android:scaleType="centerCrop" />

            <TextView android:id="@+id/tvNome" style="@style/EstiloDado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" />
            <TextView android:id="@+id/tvUsuario" style="@style/EstiloDado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvEmail" style="@style/EstiloDado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvTelefone" style="@style/EstiloDado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvCpf" style="@style/EstiloDado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/tvSenha" style="@style/EstiloDado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSair"
                style="@style/EstiloBotao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sair" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
